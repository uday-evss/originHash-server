# Server
PORT=5000
NODE_ENV=production

# MySQL database — Render has no first-party managed MySQL, so point this at an
# external provider (PlanetScale, Aiven, Railway MySQL, etc.)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=originhash
DB_USER=root
DB_PASSWORD=
# Set to "true" if your MySQL provider requires SSL (most managed providers do)
DB_SSL=false

JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Seed admin (upgraded to super-admin automatically on first server start)
ADMIN_MOBILE=7816018884
ADMIN_OTP=8884
ADMIN_NAME=Admin

# Super-admin login credentials (username + password, not OTP) — set on first
# boot only, never overwritten once a password exists. Change these before
# deploying, and change the password again after first login.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=replace_this_with_a_strong_password

# OTP settings — 2Factor SMS provider
TWO_FACTOR_API_KEY=
TWO_FACTOR_TEMPLATE_NAME=ORIGINHASH_OTP
OTP_LENGTH=4
OTP_EXPIRES_MINUTES=5

# Base URL of this backend itself
BASE_URL=http://localhost:5000

# Public frontend origin (Vercel URL in production) — QR stickers embed links
# under this origin, and it's also used for the CORS allowlist below.
PUBLIC_APP_URL=http://localhost:5173

# Comma-separated list of origins allowed to call this API (your Vercel domain(s)).
# Leave blank/unset to allow all origins (fine for local dev, not recommended in prod).
CORS_ORIGIN=

# AWS S3 configuration for image uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_UPLOAD_FOLDER=profile-photos

# Razorpay — sticker billing (prepaid wallet). Billing switches ON once the key id and secret
# are set; until then stickers stay free. Keys: Razorpay Dashboard → Account & Settings → API Keys
# (rzp_test_… for testing, rzp_live_… for real payments). Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add: URL https://<your-backend>/api/payments/razorpay/webhook,
# events payment.captured, order.paid, payment.failed. Paste the secret you choose there here.
RAZORPAY_WEBHOOK_SECRET=
# Price per sticker in paise (2000 = ₹20, "Pay As You Go").
QR_PRICE_PAISE=2000
# Plan prices (paise). Change any of these without touching code; restart the backend after.
# Subscription: price per QR per month, and the allowed monthly quantities.
PLAN_SUB_PRICE_PER_QR_PAISE=1000
PLAN_SUB_MIN_QR=100
PLAN_SUB_MAX_QR=10000
PLAN_SUB_STEP_QR=1
# Fixed + Variable: monthly fee, QR codes included, price per QR beyond that.
PLAN_FIXED_FEE_PAISE=1000000
PLAN_FIXED_INCLUDED_QR=10000
PLAN_FIXED_EXTRA_PAISE=1500
# Yearly billing (Subscription only) = 12 months upfront at this % off.
PLAN_YEARLY_DISCOUNT_PCT=20
